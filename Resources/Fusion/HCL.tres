[resource]
script = ExtResource("4_4iv6q")
requirements = Array[ExtResource("1_80ovh")]([SubResource("Resource_jk5ri"), SubResource("Resource_3g8tr")])
compound_name = "Hydrochloric Acid"
chemical_formula = "HCl"
fusion_skill_id = "acid_splash"
fusion_skill_name = "Acid Splash"
fusion_damage = 100
damage_per_atomon = 15
octet_rule_explanation = "Hydrogen has 1 valence electron and needs 1 more electron to complete its first shell. Chlorine has 7 valence electrons and needs 1 more electron to complete its outer shell. Hydrogen and chlorine share one pair of electrons, forming a single covalent bond. Through this sharing, Hydrogen achieves 2 electrons in its first shell and Chlorine achieves 8 electrons in its outer shell. This follows the Octet Rule."
fusion_description = "Hydrogen and Chlorine combine to form Hydrochloric Acid (HCl). One Hydrogen Atomon and one Chlorine Atomon are required for this fusion. The resulting fusion releases the Acid Splash attack."
metadata/_custom_type_script = "uid://5xhwjx66wmcw"
