fusion_skill_id = "carbon_burst"
fusion_skill_name = "Carbon Burst"
button_texture_normal = SubResource("Resource_utovy")
button_texture_pressed = SubResource("Resource_1faal")
fusion_damage = 85
projectile_scene = ExtResource("1_projectile")
octet_rule_explanation = "Carbon has 4 valence electrons and needs 4 more electrons to complete its octet. Each Oxygen atom has 6 valence electrons and needs 2 more electrons. Carbon and two Oxygen atoms share electrons, forming two double covalent bonds. Through this sharing, Carbon and each Oxygen atom achieve stable outer electron shells."
fusion_description = "One Carbon Atomon and two Oxygen Atomons combine to form carbon dioxide. The resulting fusion releases a powerful Carbon Burst attack."
metadata/_custom_type_script = "uid://5xhwjx66wmcw"
