[resource]
script = ExtResource("4_r8gbr")
requirements = Array[ExtResource("1_qpu81")]([SubResource("Resource_oudoo"), SubResource("Resource_c6x8i")])
compound_name = "Water"
chemical_formula = "H2O"
fusion_skill_name = "Covalent"
fusion_damage = 85
octet_rule_explanation = "Oxygen has 6 valence electrons and needs 2 more electrons to complete its outer shell. Each Hydrogen atom has 1 valence electron and needs 1 more to fill its first shell. Two Hydrogen atoms share electrons with one Oxygen atom, forming two covalent bonds. Through this sharing, Hydrogen achieves a stable first shell with 2 electrons, while Oxygen achieves a stable outer shell with 8 electrons. This follows the Octet Rule."
fusion_description = "Hydrogen and Oxygen combine to form water. Two Hydrogen Atomons and one Oxygen Atomon are required for this fusion. The resulting fusion releases a powerful Water Burst attack."
metadata/_custom_type_script = "uid://5xhwjx66wmcw"
