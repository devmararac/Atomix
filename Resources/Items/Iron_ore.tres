script = ExtResource("1_cm6hh")
item_id = "item_001"
item_name = "Iron"
description = "A dense chunk of iron ore naturally shed by Iron Atomon as they grow and strengthen their metallic bodies.

Miners believe these creatures enrich the earth with every fragment they leave behind, making regions inhabited by Iron Atomon rich in valuable deposits.

Though rough and unrefined, the ore is highly sought after by blacksmiths and engineers for forging durable equipment and crafting advanced machinery."
