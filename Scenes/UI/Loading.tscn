[sub_resource type="GDScript" id="GDScript_835t4"]
script/source = "extends CanvasLayer

@onready var ui_root = $Control 
@onready var loading_text = $Control/CenterContainer/VBox/LoadingText
@onready var progress_bar = $Control/CenterContainer/VBox/ProgressBar

var _fade_tween: Tween

func _ready() -> void:
	hide()
	progress_bar.indeterminate = true

func show_loading(text: String = \"LOADING...\") -> void:
	loading_text.text = text
	if _fade_tween and _fade_tween.is_running():
		_fade_tween.kill()
	
	show()
	ui_root.modulate.a = 0.0 
	_fade_tween = create_tween()
	_fade_tween.tween_property(ui_root, \"modulate:a\", 1.0, 0.3).set_trans(Tween.TRANS_SINE)

func hide_loading() -> void:
	if _fade_tween and _fade_tween.is_running():
		_fade_tween.kill()
		
	_fade_tween = create_tween()
	_fade_tween.tween_property(ui_root, \"modulate:a\", 0.0, 0.3).set_trans(Tween.TRANS_SINE)
	
	await _fade_tween.finished
	hide()

func set_progress(value: float) -> void:
	progress_bar.indeterminate = false
	progress_bar.value = clamp(value, 0.0, 1.0)
	if progress_bar.value >= 1.0:
		hide_loading()
"

